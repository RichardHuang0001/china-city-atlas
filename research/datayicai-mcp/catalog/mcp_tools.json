          "type": "string"
        },
        "view": {
          "default": "metrics",
          "enum": [
            "metrics",
            "summary"
          ],
          "title": "View",
          "type": "string"
        },
        "availability_state": {
          "default": "",
          "enum": [
            "",
            "queryable",
            "product_version_required",
            "metadata_only"
          ],
          "title": "Availability State",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "tags": {
          "anyOf": [
