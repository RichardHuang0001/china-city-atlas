        "metrics"
      ],
      "title": "compareArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "compareDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "city_rank",
    "description": "【城市基础数据与魅力指数】在正式 place_group 中按同一期事实排名。默认取有数的最新一期并明确覆盖/缺值；产品传 product_version_id 使用版本原选事实。名单年份与事实期不同时可传 scope_period。top_n最多50，top_n/offset翻页不改变全集分母，沿用next_offset继续。默认返回精简格式（无需新增参数）：row_defaults是本页每一行共享的完整元数据，data保留城市、数值、名次、披露状态与差异字段；完整行={...row_defaults,...data[i]}。来源、统计期及限制不可忽略；每页defaults独立。full保留原始逐行格式。",
