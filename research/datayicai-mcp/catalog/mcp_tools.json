  {
    "name": "city_resolve_places",
    "description": "【城市基础数据与魅力指数】解析地区名称、简称或代码，并返回上级名称parent_name与历史有效期。全名/编码优先；简称唯一匹配城市且其他候选为同简称区县时优先城市，caveats附选择说明及其他候选；同层级重名仍需消歧。browse=children 配 parent_place 浏览下级；browse=groups 列出正式地点组；place_group 展开指定地点组。scope_period 显式选择名单版本期，与 period 事实期分离；不传时沿用 period 选名单。目录和成员均可按 next_offset 翻页。",
    "inputSchema": {
      "properties": {
        "names": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "单个行政地区的名称或代码；城市群、都市圈、年度名单不能放在 names，应使用 place_group。",
          "title": "Names"
        },
        "place_group": {
          "default": "",
          "description": "正式城市群或名单的名称/ID；如京津冀城市群。返回该组成员，可直接把组ID传给rank。",
          "title": "Place Group",
          "type": "string"
        },
        "period": {
          "default": "",
          "title": "Period",
          "type": "string"
        },
        "browse": {
          "default": "",
          "title": "Browse",
          "type": "string"
        },
        "parent_place": {
          "default": "",
          "title": "Parent Place",
          "type": "string"
        },
        "level": {
          "default": "",
          "title": "Level",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "scope_period": {
          "default": "",
          "title": "Scope Period",
          "type": "string"
        }
      },
      "title": "resolve_placesArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "resolve_placesDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "city_query",
    "description": "【城市基础数据与魅力指数】查询已存事实。受限数值的 value 直接返回“应数据来源方要求，暂不展示具体数值。”，status 保持正常，附 value_status=restricted 和 value_notice，保留指标、时间、来源；与数据缺失不同。省略 period 时，各地点/指标分别取最新值并标实际期；period=all 返回全部已存期间，或指定单期/{start,end}。limit 最大 500，沿用 next_offset 翻页。产品传 product_version_id，省略 period 按该版原选事实取值；省略 metrics 完整展开。普通查询 latest_mode=common 可恢复共同最近期。不要把产品年份当作事实期；来源批次由服务默认选择。默认完整保留记录并对重复元数据无损去重；metadata_help说明$ref共享字典和$table年度表的展开规则。原嵌套格式用response_format=full，分页不变。",
    "inputSchema": {
      "properties": {
        "places": {
          "items": {
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "metrics": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        },
        "period": {
