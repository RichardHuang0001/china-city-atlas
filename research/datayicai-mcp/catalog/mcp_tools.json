            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Depth"
        },
        "product_version_id": {
          "default": "",
          "title": "Product Version Id",
          "type": "string"
        },
        "source_batch_id": {
          "default": "",
          "title": "Source Batch Id",
          "type": "string"
        },
        "place_period": {
          "default": "",
          "title": "Place Period",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
