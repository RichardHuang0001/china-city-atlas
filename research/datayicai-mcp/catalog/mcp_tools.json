          "title": "Offset"
        },
        "product_version_id": {
          "default": "",
          "title": "Product Version Id",
          "type": "string"
        },
        "source_batch_id": {
          "default": "",
          "title": "Source Batch Id",
          "type": "string"
        },
        "scope_period": {
          "default": "",
          "title": "Scope Period",
          "type": "string"
        },
        "response_format": {
          "default": "compact",
