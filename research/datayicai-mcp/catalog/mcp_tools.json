        "product_version_id": {
          "default": "",
          "title": "Product Version Id",
          "type": "string"
        },
        "source_batch_id": {
          "default": "",
          "title": "Source Batch Id",
          "type": "string"
        },
        "place_period": {
          "default": "",
          "title": "Place Period",
          "type": "string"
        },
        "response_format": {
          "default": "compact",
          "enum": [
            "full",
            "compact"
          ],
          "title": "Response Format",
          "type": "string"
